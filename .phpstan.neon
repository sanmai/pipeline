parameters:
    reportUnmatchedIgnoredErrors: false
    excludePaths:
        - %currentWorkingDirectory%/tests/ErrorsTest.php
        - %currentWorkingDirectory%/tests/Benchmarks/
        - %currentWorkingDirectory%/tests/Php86/
    level: 2
    paths:
        - src
        - tests
    ignoreErrors:
        -
             identifier: selfOut.type
             path: tests/StaticAnalysisTest.php
        -
             identifier: argument.type
             path: tests/Inference/
        -
             identifier: sanmai.noNestedLoops
             path: tests/
